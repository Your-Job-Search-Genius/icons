{
  "name": "@your-job-search-genius/icons",
  "version": "0.1.0",
  "description": "React icon library generated from the Writesea Odyssey Figma file (Huge Icon Set v2.0, stroke + solid variants)",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./icons/*": {
      "types": "./dist/types/icons/*.d.ts",
      "import": "./dist/esm/icons/*.js",
      "require": "./dist/cjs/icons/*.js"
    },
    "./manifest.json": "./manifest.json"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "npm run build:esm && npm run build:cjs && npm run build:types && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "build:esm": "tsc -p tsconfig.build-esm.json",
    "build:cjs": "tsx scripts/build-cjs.ts",
    "build:types": "tsc -p tsconfig.build-types.json",
    "test": "vitest run",
    "verify:treeshake": "tsx scripts/verify-treeshake.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svg-parser": "^2.0.4",
    "svgo": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
